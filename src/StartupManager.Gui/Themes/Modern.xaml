<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:StartupManager.Gui">

    <!-- DeepSeek Harness-inspired light palette -->
    <Color x:Key="C_Bg">#FFF7F8FA</Color>
    <Color x:Key="C_Panel">#FFFFFFFF</Color>
    <Color x:Key="C_PanelHover">#FFF2F3F5</Color>
    <Color x:Key="C_Border">#FFE5E6EB</Color>
    <Color x:Key="C_BorderStrong">#FFC9CDD4</Color>
    <Color x:Key="C_Primary">#FF4D6BFE</Color>
    <Color x:Key="C_PrimaryHover">#FF3A57E0</Color>
    <Color x:Key="C_Text">#FF1F2329</Color>
    <Color x:Key="C_Sub">#FF8F959E</Color>
    <Color x:Key="C_Green">#FF00B42A</Color>
    <Color x:Key="C_Red">#FFF53F3F</Color>
    <Color x:Key="C_RedHover">#FFD43030</Color>

    <SolidColorBrush x:Key="AppBg" Color="{StaticResource C_Bg}"/>
    <SolidColorBrush x:Key="Panel" Color="{StaticResource C_Panel}"/>
    <SolidColorBrush x:Key="PanelHover" Color="{StaticResource C_PanelHover}"/>
    <SolidColorBrush x:Key="Border" Color="{StaticResource C_Border}"/>
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource C_BorderStrong}"/>
    <SolidColorBrush x:Key="Primary" Color="{StaticResource C_Primary}"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="{StaticResource C_PrimaryHover}"/>
    <SolidColorBrush x:Key="Txt" Color="{StaticResource C_Text}"/>
    <SolidColorBrush x:Key="Sub" Color="{StaticResource C_Sub}"/>
    <SolidColorBrush x:Key="Green" Color="{StaticResource C_Green}"/>
    <SolidColorBrush x:Key="Red" Color="{StaticResource C_Red}"/>
    <SolidColorBrush x:Key="RedHover" Color="{StaticResource C_RedHover}"/>

    <!--
        Menu-only theme keys. Their light values match the existing palette, but every
        consumer references them via DynamicResource. A future dark theme only has to
        merge a dictionary that redefines these same three keys with dark values — no
        control template needs to change. That is the "follow dark theme" hook.
    -->
    <SolidColorBrush x:Key="MenuHover" Color="#FFF2F3F5"/>
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#FFE5E6EB"/>
    <SolidColorBrush x:Key="MenuSurface" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="MenuText" Color="#FF1F2329"/>

    <local:FilePathToIconConverter x:Key="IconCv"/>
    <local:CommandToIconConverter x:Key="IconCvExe"/>
    <local:InverseBoolConverter x:Key="InverseBoolCv"/>
    <local:BoolTextConverter x:Key="BoolTextCv"/>
    <local:BoolBrushConverter x:Key="BoolBrushCv"/>
    <local:BoolToVisibilityConverter x:Key="BoolVisCv"/>
    <local:NonEmptyToVisibilityConverter x:Key="NonEmptyVisCv"/>

    <!-- primary (filled blue) button -->
    <Style x:Key="PrimaryBtn" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Primary}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource PrimaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource BorderStrong}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- default (outlined/quiet) button -->
    <Style x:Key="QuietBtn" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="Foreground" Value="{StaticResource Txt}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource PanelHover}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- danger button (delete) -->
    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource QuietBtn}">
        <Setter Property="Foreground" Value="{StaticResource Red}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFFEECEC"/>
                <Setter Property="BorderBrush" Value="{StaticResource Red}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="Foreground" Value="{StaticResource Txt}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="RowHeight" Value="40"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="Margin" Value="14"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternationCount" Value="2"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="Foreground" Value="{StaticResource Sub}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="SeparatorVisibility" Value="Collapsed"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                              ContentSource="Content" RecognizesAccessKey="True"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0"
                                       Foreground="{StaticResource Primary}" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value=""/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SortDirection}"
                                                         Value="Ascending">
                                                <Setter Property="Text" Value="▲"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SortDirection}"
                                                         Value="Descending">
                                                <Setter Property="Text" Value="▼"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Txt}"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="#FFFCFCFD"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PanelHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#FFF5F7FA"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <!-- No selection highlight at all: the cell must never paint the system-blue
             "selected / copyable" block. Row-level hover/alternation is provided by
             the DataGridRow style instead. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon column: no padding so a 20px icon is never clipped by the cell margins. -->
    <Style x:Key="IconCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource Sub}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="0,0,0,2" Margin="2,0" Padding="{TemplateBinding Padding}"
                            CornerRadius="6,6,0,0">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Txt}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="Foreground" Value="{StaticResource Sub}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuText}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!--
        Style for the four top-level menu roots (编辑/设置/关于/退出).
        Font 14, line-height 1.6 => 22.4px MinHeight, 12px horizontal padding,
        8px radius, light-grey hover. BasedOn the shared MenuItem style, so only
        these setters change — the control template (arrow/popup/gesture) is untouched.
        MenuHover / MenuText / MenuSeparatorBrush are DynamicResource so a dark theme
        can override the same keys without any template change.
    -->
    <Style x:Key="MenuRootItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Foreground" Value="{DynamicResource MenuText}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="22.4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                            Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuIcon"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="IconHost" Grid.Column="0"
                                              ContentSource="Icon" VerticalAlignment="Center"
                                              Margin="0,0,8,0" Width="16" Height="16"/>
                            <ContentPresenter x:Name="HeaderHost" Grid.Column="1"
                                              ContentSource="Header" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                            <TextBlock x:Name="GestureHost" Grid.Column="2" Margin="18,0,0,0"
                                       Foreground="{DynamicResource MenuText}" FontSize="12"
                                       VerticalAlignment="Center" Text="{TemplateBinding InputGestureText}"/>
                            <Path x:Name="Arrow" Grid.Column="3" Margin="12,0,0,0"
                                  Width="8" Height="8" Stretch="Uniform" Visibility="Collapsed"
                                  VerticalAlignment="Center" Data="M0,0 L4,4 L0,8"
                                  Stroke="{DynamicResource MenuText}" StrokeThickness="1.4"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}" Focusable="False"
                                   PopupAnimation="Fade" HorizontalOffset="0" VerticalOffset="4">
                                <Border Background="{DynamicResource MenuSurface}" CornerRadius="10"
                                        BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="1"
                                        Padding="5" Margin="0,0,10,10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.16" Color="#1F2329"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHover}"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource MenuText}"/>
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- implicit MenuItem style (context menus etc.): same menu theme keys -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource MenuText}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="22.4"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                            Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuIcon"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- optional icon slot -->
                            <ContentPresenter x:Name="IconHost" Grid.Column="0"
                                              ContentSource="Icon" VerticalAlignment="Center"
                                              Margin="0,0,8,0" Width="16" Height="16"/>

                            <ContentPresenter x:Name="HeaderHost" Grid.Column="1"
                                              ContentSource="Header" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>

                            <TextBlock x:Name="GestureHost" Grid.Column="2" Margin="18,0,0,0"
                                       Foreground="{DynamicResource MenuText}" FontSize="12"
                                       VerticalAlignment="Center" Text="{TemplateBinding InputGestureText}"/>

                            <!-- submenu arrow -->
                            <Path x:Name="Arrow" Grid.Column="3" Margin="12,0,0,0"
                                  Width="8" Height="8" Stretch="Uniform" Visibility="Collapsed"
                                  VerticalAlignment="Center" Data="M0,0 L4,4 L0,8"
                                  Stroke="{DynamicResource MenuText}" StrokeThickness="1.4"/>

                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}" Focusable="False"
                                   PopupAnimation="Fade" HorizontalOffset="0" VerticalOffset="4">
                                <Border Background="{DynamicResource MenuSurface}" CornerRadius="10"
                                        BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="1"
                                        Padding="5" Margin="0,0,10,10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.16" Color="#1F2329"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHover}"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource MenuText}"/>
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolBar">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- rounded, shadowed context menus to match the Electron-style dialogs -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="Foreground" Value="{StaticResource Txt}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}"
                            Margin="0,0,10,10" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.16" Color="#1F2329"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 1px separator that follows the menu theme keys -->
    <Style x:Key="MenuSeparator" TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="6,4"/>
        <Setter Property="Background" Value="{DynamicResource MenuSeparatorBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- menu item with a leading glyph; Danger=True tints it red -->
    <Style x:Key="GlyphMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource MenuText}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="22.4"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                            Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Glyph" Grid.Column="0" Margin="0,0,9,0"
                                       FontSize="14" Width="16" TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Tag}"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerMenuItem" TargetType="MenuItem" BasedOn="{StaticResource GlyphMenuItem}">
        <Setter Property="Foreground" Value="{StaticResource Red}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                            Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Glyph" Grid.Column="0" Margin="0,0,9,0"
                                       FontSize="14" Width="16" TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Red}"
                                       Text="{TemplateBinding Tag}"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

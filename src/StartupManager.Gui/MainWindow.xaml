<Window x:Class="StartupManager.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StartupManager.Gui"
        Title="" Height="680" Width="1060"
        Background="{StaticResource AppBg}" FontFamily="Microsoft YaHei" FontSize="13"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True">

    <DockPanel>
        <!-- top bar: left = app title (shows current page) + menus -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,6">
                <Image x:Name="AppIconImage" Width="22" Height="22" Stretch="Uniform"
                       VerticalAlignment="Center" Margin="12,0,14,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Menu Background="Transparent" BorderThickness="0">
                    <MenuItem Header="编辑">
                        <MenuItem Header="刷新" Tag="↻" Style="{StaticResource GlyphMenuItem}" Click="OnRefresh"/>
                        <MenuItem Header="新建启动项" Tag="＋" Style="{StaticResource GlyphMenuItem}" Click="OnAdd"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <MenuItem Header="退出程序" Tag="✕" Style="{StaticResource GlyphMenuItem}" Click="OnExit"/>
                    </MenuItem>
                    <MenuItem Header="设置">
                        <MenuItem Header="MCP 服务…" Tag="⚙" Style="{StaticResource GlyphMenuItem}" Click="OnShowMcp"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <MenuItem Header="打开数据目录" Tag="📁" Style="{StaticResource GlyphMenuItem}" Click="OnOpenDataDir"/>
                    </MenuItem>
                    <MenuItem Header="关于" Tag="ℹ" Style="{StaticResource GlyphMenuItem}" Click="OnAbout"/>
                </Menu>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Sub}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- left navigation rail: icon + label -->
        <Border DockPanel.Dock="Left" Width="180" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                     SelectionChanged="Nav_OnSelectionChanged" Margin="8">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,12"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Foreground" Value="{StaticResource Sub}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#EAF0FF"/>
                                            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBoxItem Tag="Startup">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M3 4h14v2H3V4zm0 5h14v2H3V9zm0 5h14v2H3v-2z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Width="18" Height="18" Stretch="Uniform"/>
                        <TextBlock Text="启动项" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Delayed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M8 1a7 7 0 100 14A7 7 0 008 1zm0 2a5 5 0 110 10A5 5 0 018 3zm0 1v4l3 2 .9-1.5L9 8V4H8z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Width="18" Height="18" Stretch="Uniform"/>
                        <TextBlock Text="延迟启动项" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Queues">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M3 3h12v3H3V3zm0 5h12v3H3V8zm0 5h12v3H3v-3z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Width="18" Height="18" Stretch="Uniform"/>
                        <TextBlock Text="执行队列" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </Border>

        <!-- right content area -->
        <Grid>
            <!-- ===== 启动项 page ===== -->
            <DockPanel x:Name="StartupPage" LastChildFill="True">
                <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow" ClipboardCopyMode="None"
                          ItemsSource="{Binding EntriesView}"
                          MouseDoubleClick="Grid_OnDoubleClick"
                          PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                          Sorting="Grid_OnSorting"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="启用" Tag="✓" Style="{StaticResource GlyphMenuItem}" Click="OnEnable"/>
                            <MenuItem Header="禁用" Tag="○" Style="{StaticResource GlyphMenuItem}" Click="OnDisable"/>
                            <Separator Style="{StaticResource MenuSeparator}"/>
                            <MenuItem Header="打开文件所在位置" Tag="📁" Style="{StaticResource GlyphMenuItem}" Click="OnOpenLocation"/>
                            <Separator Style="{StaticResource MenuSeparator}"/>
                            <MenuItem Header="删除" Tag="🗑" Style="{StaticResource DangerMenuItem}" Click="OnRemove"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="44" SortMemberPath="Name"
                                                CellStyle="{StaticResource IconCell}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding FilePath, Converter={StaticResource IconCv}}"
                                           Width="20" Height="20" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="状态" Width="84" SortMemberPath="Enabled">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="11" Padding="10,3" HorizontalAlignment="Left"
                                            Background="{Binding Enabled, Converter={StaticResource BoolBrushCv}}">
                                        <TextBlock Text="{Binding Enabled, Converter={StaticResource BoolTextCv}}"
                                                   Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180" Foreground="{StaticResource Txt}" SortMemberPath="Name"/>
                        <DataGridTextColumn Header="位置" Binding="{Binding LocationText}" Width="200" Foreground="{StaticResource Sub}" SortMemberPath="LocationText"/>
                        <DataGridTextColumn Header="命令" Binding="{Binding Command}" Width="*" Foreground="{StaticResource Txt}" SortMemberPath="Command"/>
                        <DataGridTextColumn Header="发行者" Binding="{Binding Manufacturer}" Width="160" Foreground="{StaticResource Sub}" SortMemberPath="Manufacturer"/>
                        <DataGridTextColumn Header="延迟(s)" Binding="{Binding DelaySeconds}" Width="70" Foreground="{StaticResource Sub}" SortMemberPath="DelaySeconds"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- ===== 延迟启动 page ===== -->
            <DockPanel x:Name="DelayedPage" LastChildFill="True" Visibility="Collapsed" Margin="8">
                <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="6,6,6,12">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Sub}" Margin="0,0,0,10">
                            延迟启动由本工具统一管理：登录后，本工具的延迟器会按各项设定的秒数（自登录起算，互不累加）等待，再依次启动目标程序，从而错开开机负载。修改下方任意项的延迟秒数或启用状态会即时保存。
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Content="随登录自动启动延迟器" IsChecked="{Binding DelayedSelfStarterOn}"
                                      VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource PrimaryBtn}" Content="立即启动一次（测试）" Width="160"
                                    Margin="10,0,0,0" Click="OnLaunchDelayedNow"/>
                            <Button Style="{StaticResource QuietBtn}" Content="＋ 添加延迟项" Width="130"
                                    Margin="10,0,0,0" Click="OnAddDelayed"/>
                            <TextBlock Text="{Binding DelayedSelfStarterOn, StringFormat=当前状态：{0}, Mode=OneWay}"
                                       Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="DelayGrid" AutoGenerateColumns="False" IsReadOnly="False"
                          ItemsSource="{Binding DelayedEntries}" SelectionMode="Single"
                          SelectionUnit="FullRow" ClipboardCopyMode="None"
                          Margin="6,0,6,6" CellEditEnding="DelayGrid_OnCellEdit"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="删除" Tag="🗑" Style="{StaticResource DangerMenuItem}" Click="OnRemove"/>
                            <Separator Style="{StaticResource MenuSeparator}"/>
                            <MenuItem Header="打开文件所在位置" Tag="📁" Style="{StaticResource GlyphMenuItem}" Click="OnOpenLocation"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="44" CellStyle="{StaticResource IconCell}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding FilePath, Converter={StaticResource IconCv}}"
                                           Width="20" Height="20" Stretch="Uniform"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" IsReadOnly="True" Width="180" Foreground="{StaticResource Txt}"/>
                        <DataGridTextColumn Header="命令" Binding="{Binding Command}" IsReadOnly="True" Width="*" Foreground="{StaticResource Txt}"/>
                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                Width="60"/>
                        <DataGridTextColumn Header="延迟(秒)" Binding="{Binding DelaySeconds, UpdateSourceTrigger=LostFocus}"
                                            Width="90" Foreground="{StaticResource Sub}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- ===== execution queues page ===== -->
            <DockPanel x:Name="QueuePage" LastChildFill="True" Visibility="Collapsed" Margin="8">
                <Grid DockPanel.Dock="Top" Margin="6,6,6,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                            BorderThickness="1" CornerRadius="10" Padding="12">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="队列" FontWeight="SemiBold" Foreground="{StaticResource Txt}" Margin="0,0,0,8"/>

                            <!-- Rename / delete live on the list's context menu. -->
                            <Button DockPanel.Dock="Top" Style="{StaticResource PrimaryBtn}" Content="＋ 新建队列"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="OnAddQueue"/>

                            <ListBox x:Name="QueueList" ItemsSource="{Binding Queues}"
                                     SelectedItem="{Binding SelectedQueue}"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="编辑（重命名）" Tag="✎" Style="{StaticResource GlyphMenuItem}" Click="OnEditQueue"/>
                                        <MenuItem Header="从磁盘重新载入" Tag="⟳" Style="{StaticResource GlyphMenuItem}" Click="OnReloadQueues"/>
                                        <Separator Style="{StaticResource MenuSeparator}"/>
                                        <MenuItem Header="删除队列" Tag="🗑" Style="{StaticResource DangerMenuItem}" Click="OnRemoveQueue"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,9"/>
                                        <Setter Property="Margin" Value="0,2"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Foreground" Value="{StaticResource Txt}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#EAF0FF"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <DockPanel Grid.Column="1" Margin="12,0,0,0" LastChildFill="True">
                        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="队列名称：" VerticalAlignment="Center" Foreground="{StaticResource Sub}"/>
                                <TextBlock x:Name="QueueNameText" VerticalAlignment="Center" FontWeight="SemiBold"
                                           FontSize="14" Foreground="{StaticResource Txt}"
                                           Text="{Binding SelectedQueue.Name}"
                                           Margin="0,0,0,0" MinWidth="60"/>
                                <Button Style="{StaticResource PrimaryBtn}" Content="▶ 一键启动队列" Width="150" Margin="16,0,0,0"
                                        Click="OnStartQueue" IsEnabled="{Binding QueueRunning, Converter={StaticResource InverseBoolCv}}"/>
                                <Button Style="{StaticResource QuietBtn}" Content="＋ 添加应用" Width="120" Margin="10,0,0,0" Click="OnAddQueueItem"/>
                            </StackPanel>
                        </Border>

                        <!-- execution timeline: shows what the queue is doing, step by step -->
                        <Border DockPanel.Dock="Top" Background="#F7F8FA" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="执行过程" FontWeight="SemiBold" Foreground="{StaticResource Txt}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding QueueRunSummary}" Foreground="{StaticResource Sub}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding QueueSteps}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" CornerRadius="8" Padding="10,7" Margin="0,0,8,8"
                                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                    ToolTip="{Binding ErrorDetail}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="18" Height="18" CornerRadius="9"
                                                            Background="{Binding StateBrush}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StepNo}" Foreground="White"
                                                                   FontSize="9" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Txt}"
                                                                       FontSize="12" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                                            <!-- red warning marker, only when this step failed -->
                                                            <TextBlock Text=" ⚠" FontSize="12" Foreground="{StaticResource Red}"
                                                                       Visibility="{Binding HasError, Converter={StaticResource BoolVisCv}}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding StateText}" FontSize="10"
                                                                       Foreground="{Binding StateBrush}"/>
                                                            <TextBlock Text="{Binding DelayText}" FontSize="10"
                                                                       Foreground="{StaticResource Sub}" Margin="6,0,0,0"/>
                                                        </StackPanel>
                                                        <!-- concrete error text, wrapped so nothing is cut off -->
                                                        <TextBlock Text="{Binding ErrorDetail}" FontSize="10" MaxWidth="230"
                                                                   TextWrapping="Wrap" Foreground="{StaticResource Red}"
                                                                   Visibility="{Binding HasError, Converter={StaticResource BoolVisCv}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- aggregated error banner: stays visible after the run ends -->
                                <Border Margin="0,4,0,0" Padding="10,7" CornerRadius="6"
                                        Background="#FFFDECEC" BorderBrush="{StaticResource Red}" BorderThickness="1"
                                        Visibility="{Binding QueueErrorSummary, Converter={StaticResource NonEmptyVisCv}}">
                                    <StackPanel>
                                        <TextBlock Text="⚠ 本次执行出现启动失败，报错如下：" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Red}" FontSize="11"/>
                                        <TextBlock Text="{Binding QueueErrorSummary}" Foreground="{StaticResource Txt}"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="按各自延迟从点击时刻起依次启动；圆点表示当前进度，失败步骤显示具体报错。"
                                           Foreground="{StaticResource Sub}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="QueueGrid" AutoGenerateColumns="False" IsReadOnly="False"
                                  ItemsSource="{Binding SelectedQueue.Items}" SelectionMode="Single"
                                  SelectionUnit="FullRow" ClipboardCopyMode="None"
                                  Margin="0,0,0,6" CellEditEnding="QueueGrid_OnCellEdit"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="QueueGrid_OnPreviewMouseLeftButtonDown"
                                  PreviewMouseMove="QueueGrid_OnPreviewMouseMove"
                                  DragOver="QueueGrid_OnDragOver"
                                  Drop="QueueGrid_OnDrop"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                  ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="修改…" Tag="✎" Style="{StaticResource GlyphMenuItem}" Click="OnEditQueueItem"/>
                                    <Separator Style="{StaticResource MenuSeparator}"/>
                                    <MenuItem Header="上移" Tag="↑" Style="{StaticResource GlyphMenuItem}" Click="OnQueueItemMoveUp"/>
                                    <MenuItem Header="下移" Tag="↓" Style="{StaticResource GlyphMenuItem}" Click="OnQueueItemMoveDown"/>
                                    <Separator Style="{StaticResource MenuSeparator}"/>
                                    <MenuItem Header="删除" Tag="🗑" Style="{StaticResource DangerMenuItem}" Click="OnRemoveQueueItem"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="44" CellStyle="{StaticResource IconCell}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Command, Converter={StaticResource IconCvExe}}"
                                                   Width="20" Height="20" Stretch="Uniform"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" IsReadOnly="True" Width="180" Foreground="{StaticResource Txt}"/>
                                <DataGridTextColumn Header="命令" Binding="{Binding Command}" IsReadOnly="True" Width="*" Foreground="{StaticResource Txt}"/>
                                <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                <DataGridTextColumn Header="延迟(秒)" Binding="{Binding DelaySeconds, UpdateSourceTrigger=LostFocus}" Width="90" Foreground="{StaticResource Sub}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>

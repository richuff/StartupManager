<Window x:Class="StartupManager.Gui.EditQueueItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改队列项" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="Microsoft YaHei" FontSize="13">
    <Border Background="White" CornerRadius="10" BorderBrush="#E5E6EB" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.30" Color="#1F2329"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Border Grid.Row="0" Background="#F7F8FA" CornerRadius="10,10,0,0"
                    BorderBrush="#E5E6EB" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnDrag">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="添加应用" FontWeight="SemiBold" Foreground="#1F2329"
                               VerticalAlignment="Center" Margin="16,0"/>
                    <Button Content="✕" Width="32" Height="32" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0" Foreground="#8F959E"
                            FontSize="14" Cursor="Hand" Click="OnCancel">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FFECEC"/>
                                                    <Setter Property="Foreground" Value="#F53F3F"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- body -->
            <StackPanel Grid.Row="1" Margin="20,16,20,16">
                <Label Content="名称：" Target="{Binding ElementName=NameBox}" Padding="0,0,0,4" Foreground="#1F2329"/>
                <TextBox x:Name="NameBox" Padding="10,7" BorderBrush="#E5E6EB" BorderThickness="1"
                         Background="White" Foreground="#1F2329"/>

                <Label Content="命令（可执行文件路径，可带参数）：" Target="{Binding ElementName=CommandBox}"
                       Padding="0,10,0,4" Foreground="#1F2329"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CommandBox" Grid.Column="0" Padding="10,7" BorderBrush="#E5E6EB"
                             BorderThickness="1" Background="White" Foreground="#1F2329"/>
                    <Button Content="浏览…" Grid.Column="1" Width="78" Margin="8,0,0,0" Padding="10,7"
                            Background="White" BorderBrush="#E5E6EB" BorderThickness="1" Foreground="#1F2329"
                            Cursor="Hand" Click="OnBrowse">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F2F3F5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="确定" Width="88" Margin="0,0,10,0" Padding="10,8" IsDefault="True"
                            Background="#4D6BFE" BorderThickness="0" Foreground="White" Cursor="Hand" Click="OnOk">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#3A57E0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="取消" Width="88" Padding="10,8" IsCancel="True"
                            Background="White" BorderBrush="#E5E6EB" BorderThickness="1" Foreground="#1F2329"
                            Cursor="Hand" Click="OnCancel">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F2F3F5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="StartupManager.Gui.AddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StartupManager.Gui"
        Title="添加启动项" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="Segoe UI" FontSize="13">
    <Border Background="White" CornerRadius="10" BorderBrush="#E5E6EB" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.30" Color="#1F2329"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- title bar (Electron-style: draggable, with close button) -->
            <Border Grid.Row="0" Background="#F7F8FA" CornerRadius="10,10,0,0"
                    BorderBrush="#E5E6EB" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnDrag">
                <Grid>
                    <TextBlock Text="添加启动项" FontWeight="SemiBold" Foreground="#1F2329"
                               VerticalAlignment="Center" Margin="16,0"/>
                    <Button x:Name="CloseBtn" Content="✕" Width="32" Height="32" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0" Foreground="#8F959E"
                            FontSize="14" Cursor="Hand" Click="OnCancel">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FFECEC"/>
                                                    <Setter Property="Foreground" Value="#F53F3F"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- body -->
            <StackPanel Grid.Row="1" Margin="20,16,20,16">
                <Label Content="名称：" Target="{Binding ElementName=NameBox}" Padding="0,0,0,4" Foreground="#1F2329"/>
                <TextBox x:Name="NameBox" Padding="10,7" BorderBrush="#E5E6EB" BorderThickness="1" Background="White" Foreground="#1F2329"/>

                <Label Content="命令（可执行文件路径，可带参数）：" Target="{Binding ElementName=CommandBox}" Padding="0,10,0,4" Foreground="#1F2329"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CommandBox" Grid.Column="0" Padding="10,7" BorderBrush="#E5E6EB" BorderThickness="1"
                             Background="White" Foreground="#1F2329" LostFocus="CommandBox_OnLostFocus"/>
                    <Button Content="浏览…" Grid.Column="1" Width="78" Margin="8,0,0,0" Padding="10,7"
                            Background="White" BorderBrush="#E5E6EB" BorderThickness="1" Foreground="#1F2329"
                            Cursor="Hand" Click="OnBrowse">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F2F3F5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Label Content="启动位置：" Target="{Binding ElementName=LocationCombo}" Padding="0,10,0,4" Foreground="#1F2329"/>
                <ComboBox x:Name="LocationCombo" Padding="8,6" BorderBrush="#E5E6EB" BorderThickness="1" Background="White" Foreground="#1F2329"/>

                <Label x:Name="DelayLabel" Content="延迟（秒，登录后等待时间）：" Target="{Binding ElementName=DelayBox}" Padding="0,10,0,4" Foreground="#1F2329" Visibility="Collapsed"/>
                <Grid x:Name="DelayHost" Visibility="Collapsed">
                    <TextBox x:Name="DelayBox" Padding="10,7" BorderBrush="#E5E6EB" BorderThickness="1"
                             Background="White" Foreground="#1F2329"
                             TextChanged="DelayBox_OnTextChanged"/>
                    <TextBlock x:Name="DelayPlaceholder" Text="延迟秒数，留空默认 30"
                               Foreground="#8F959E" Margin="11,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>

                <CheckBox x:Name="EnabledBox" Content="启用" IsChecked="True" Margin="0,12,0,16" Foreground="#1F2329"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="确定" Width="88" Margin="0,0,10,0" Padding="10,8" IsDefault="True"
                            Background="#4D6BFE" BorderThickness="0" Foreground="White" FontWeight="Medium"
                            Cursor="Hand" Click="OnOk">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#3A57E0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="取消" Width="88" Padding="10,8"
                            Background="White" BorderBrush="#E5E6EB" BorderThickness="1" Foreground="#1F2329"
                            Cursor="Hand" Click="OnCancel" IsCancel="True">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F2F3F5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
